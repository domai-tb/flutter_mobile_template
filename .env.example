# Example Environment Configuration
# Copy this file to .env, .env.dev, or .env.prod and fill in your values

# API Configuration
API_BASE_URL=https://api.example.com
API_TIMEOUT=30000

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# Logging
LOG_LEVEL=debug

# Other
APP_NAME=Mobile App Skeleton

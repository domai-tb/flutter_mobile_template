# Environment Configuration (Reference Only)
#
# This template no longer uses .env files bundled in the app.
# Configuration is now handled via compile-time constants using --dart-define flags.
#
# Example usage:
# flutter run --dart-define=API_BASE_URL=https://dev-api.example.com --dart-define=LOG_LEVEL=debug
# flutter build apk --dart-define=API_BASE_URL=https://api.prod.com --dart-define=LOG_LEVEL=error
#
# Available Configuration Values:
# - API_BASE_URL (default: https://api.example.com)
# - API_TIMEOUT (default: 30000)
# - ENABLE_ANALYTICS (default: false)
# - ENABLE_CRASH_REPORTING (default: false)
# - LOG_LEVEL (default: info)
# - APP_NAME (default: Mobile App Skeleton)
#
# See EnvironmentConfig class (lib/core/environment_config.dart) for all available values.
